{
  "mode": "codebuddy",
  "port": 18792,
  "entry": "cb-gateway.mjs",
  "alwaysStart": true,
  "requestLimitMiB": 256,
  "upstreamRequestLimitMiB": 128,
  "imagePolicy": { "maxImages": 16, "recentImages": 2, "historyMaxEdge": 1280, "recentMaxEdge": 2048 },
  "model": "deepseek-v4.1-flash",
  "fastModel": "deepseek-v4.1-flash",
  "effortDefault": "high",
  "effortPolicy": "client",
  "effortMaxByModel": {},
  "followClients": false,
  "exactRoutes": {
    "claude-fable-5": "deepseek-v4.1-flash",
    "claude-haiku-5": "minimax-m3.1-flash",
    "claude-haiku-5-5": "glm-5.3-flashx",
    "claude-fable-5-1": "minimax-m3.1-flash"
  },
  "modelRoutes": [],
  "models": [
    {
      "id": "deepseek-v4.1-flash",
      "name": "cb/ Deepseek-V4.1-Flash (0.11x) · 1M",
      "context": 1000000,
      "multiplier": "0.11",
      "maxOutput": 128000
    },
    {
      "id": "minimax-m3.1-flash",
      "name": "cb/ MiniMax-M3.1-Flash (0.08x) · 1M",
      "context": 1000000,
      "multiplier": "0.08",
      "maxOutput": 128000
    },
    {
      "id": "glm-5.3-flashx",
      "name": "cb/ GLM-5.3-FlashX (0.19x) · 1M",
      "context": 1000000,
      "multiplier": "0.19",
      "maxOutput": 131072
    }
  ],
  "upstream": "https://copilot.tencent.com"
}
